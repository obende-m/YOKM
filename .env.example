# Copy to .env (local development) and set the same values in Vercel
# (Project → Settings → Environment Variables, for Production and Preview).
#
# Both values come from Supabase → Project Settings → API (Data API / API Keys).
# They are public by design: the browser uses them, and Row Level Security in
# the database decides what each visitor may read or change.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy "anon" public key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put the service_role / secret key in this file or in any VITE_ variable.
# The website does not need it.
